{
  "version": 2,
  "description": "ADR-0022 and its Amendment A. Output that says a test runner ran no tests (kind no_tests, the default) or skipped every test it found (kind all_skipped: at least one skip, todo or pending, and no pass), or could not start what it needs to run (kind environment, ADR-0031: e.g. a webServer that did not start). A result is named when some signature's pattern matches (re.MULTILINE, over stdout and stderr together) with the exit code in its exits, and no signature's positive pattern (a count of tests that ran) matches anywhere. Signatures are tried in order; each runner's all_skipped entry precedes its no_tests entry. kind only chooses the detail wording. An optional requires pattern must also match somewhere (the runner's own context, such as Playwright's 'Running N tests using M workers' header). Patterns are anchored so prose that quotes them does not count, and never let whitespace cross a newline after ^, so matching stays linear. ANSI escapes are stripped before matching. A malformed entry (including an unknown kind) is skipped; the others still apply.",
  "signatures": [
    {"id": "pytest-all-skipped", "kind": "all_skipped", "runner": "pytest, every collected test skipped", "pattern": "^=*[ \\t]*[1-9]\\d* skipped(?:, \\d+ deselected)?(?:, \\d+ warnings?)? in \\d", "positive": "\\b[1-9]\\d* passed\\b", "exits": [0]},
    {"id": "pytest", "runner": "pytest", "pattern": "^=*[ \\t]*no tests ran\\b", "positive": "\\b[1-9]\\d* passed\\b", "exits": [0, 5]},
    {"id": "pytest-deselected", "runner": "pytest -k / -m that selects nothing", "pattern": "^=*[ \\t]*\\d+ deselected\\b", "positive": "\\b[1-9]\\d* passed\\b", "exits": [5]},
    {"id": "unittest-all-skipped", "kind": "all_skipped", "runner": "python -m unittest, every test skipped", "pattern": "(?:^s+[ \\t\\r]*\\n|(?:\\.\\.\\. |^)skipped (?:'[^'\\r\\n]*'|\\\"[^\\\"\\r\\n]*\\\")[ \\t\\r]*\\n[ \\t\\r]*\\n)-{70}[ \\t\\r]*\\nRan (?:0 tests in [^\\r\\n]*\\r?\\n\\r?\\n(?:OK|NO TESTS RAN) \\(skipped=[1-9]\\d*\\)|([1-9]\\d*) tests? in [^\\r\\n]*\\r?\\n\\r?\\n(?:OK|NO TESTS RAN) \\(skipped=\\1\\))[ \\t\\r]*$", "positive": "^(?:Ran ([1-9]\\d*) tests? in [^\\r\\n]*\\r?$(?!\\n\\r?\\n(?:OK|NO TESTS RAN) \\(skipped=\\1\\)[ \\t\\r]*$)|[sEF]*[.x][.sxuEF]*[ \\t\\r]*$)|^(?:(?=[^\\r\\n]*? \\.\\.\\. )[^\\r\\n]*\\b)?(?:ok|expected failure)[ \\t\\r]*$", "exits": [0, 5]},
    {"id": "unittest", "runner": "python -m unittest", "pattern": "^Ran 0 tests in\\b", "positive": "^(?:Ran ([1-9]\\d*) tests? in [^\\r\\n]*\\r?$(?!\\n\\r?\\n(?:OK|NO TESTS RAN) \\(skipped=\\1\\)[ \\t\\r]*$)|[sEF]*[.x][.sxuEF]*[ \\t\\r]*$)|^(?:(?=[^\\r\\n]*? \\.\\.\\. )[^\\r\\n]*\\b)?(?:ok|expected failure)[ \\t\\r]*$", "exits": [0, 5]},
    {"id": "jest-all-skipped", "kind": "all_skipped", "runner": "jest, every test skipped or todo", "pattern": "^Tests:[ \\t]+(?:[1-9]\\d* skipped, (?:[1-9]\\d* todo, )?|[1-9]\\d* todo, )[1-9]\\d* total[ \\t\\r]*$", "positive": "^Tests:[ \\t].*\\b[1-9]\\d* passed\\b", "exits": [0]},
    {"id": "jest", "runner": "jest --passWithNoTests", "pattern": "^No tests found, exiting with code 0\\b", "positive": "^Tests:[ \\t].*\\b[1-9]\\d* passed\\b", "exits": [0]},
    {"id": "vitest-all-skipped", "kind": "all_skipped", "runner": "vitest, every test skipped or todo", "pattern": "^[ \\t]*Tests[ \\t]+(?:[1-9]\\d* skipped(?: \\| [1-9]\\d* todo)?|[1-9]\\d* todo) \\(\\d+\\)[ \\t\\r]*$", "positive": "^[ \\t]*Tests[ \\t]+.*\\b[1-9]\\d* passed\\b", "exits": [0]},
    {"id": "vitest", "runner": "vitest --passWithNoTests", "pattern": "^No test files found, exiting with code 0\\b", "positive": "^[ \\t]*Tests[ \\t]+.*\\b[1-9]\\d* passed\\b", "exits": [0]},
    {"id": "playwright-all-skipped", "kind": "all_skipped", "runner": "playwright test, every test skipped", "requires": "^Running [1-9]\\d* tests? using [1-9]\\d* workers?\\b", "pattern": "^[ \\t]*[1-9]\\d* skipped[ \\t\\r]*$", "positive": "^[ \\t]*[1-9]\\d* (?:passed|flaky)\\b", "exits": [0]},
    {"id": "playwright", "runner": "playwright test --pass-with-no-tests", "pattern": "^(?:Error: )?No tests found\\.?[ \\t\\r]*$", "positive": "^[ \\t]*[1-9]\\d* (?:passed|flaky)\\b", "exits": [0]},
    {"id": "playwright-webserver", "kind": "environment", "runner": "playwright test, its webServer did not start (a port already in use, a server that exited)", "pattern": "^(?:Error: )?Process from config\\.webServer (?:was not able to start|exited early)", "positive": "^[ \t]*[1-9]\\d* (?:passed|flaky)\b", "exits": [1]},
    {"id": "node-test-all-skipped", "kind": "all_skipped", "runner": "node --test, every test skipped or todo", "pattern": "^([#ℹ]) pass 0[ \\t\\r]*\\n\\1 fail 0[ \\t\\r]*\\n\\1 cancelled 0[ \\t\\r]*\\n\\1 skipped (?:[1-9]\\d*[ \\t\\r]*\\n\\1 todo \\d+|0[ \\t\\r]*\\n\\1 todo [1-9]\\d*)[ \\t\\r]*$", "positive": "^(?:#|ℹ) pass [1-9]\\d*[ \\t\\r]*$", "exits": [0]},
    {"id": "node-test", "runner": "node --test", "pattern": "^(?:#|ℹ) tests 0[ \\t\\r]*$", "positive": "^(?:#|ℹ) pass [1-9]\\d*[ \\t\\r]*$", "exits": [0]},
    {"id": "mocha-all-pending", "kind": "all_skipped", "runner": "mocha, every test pending", "pattern": "^[ \\t]*0 passing\\b[^\\r\\n]*\\r?\\n[ \\t]*[1-9]\\d* pending\\b", "positive": "^[ \\t]*[1-9]\\d* passing\\b", "exits": [0]},
    {"id": "mocha", "runner": "mocha", "pattern": "^[ \\t]*0 passing\\b", "positive": "^[ \\t]*[1-9]\\d* passing\\b", "exits": [0]},
    {"id": "go-all-skipped", "kind": "all_skipped", "runner": "go test -v, every test skipped (without -v a skip prints nothing)", "pattern": "^[ \\t]*--- SKIP: ", "positive": "^(?:(?<!PASS\\n)(?<!PASS\\r\\n)ok[ \\t]+\\S+[ \\t]+(?:\\(cached\\)|\\d[\\d.]*m?s)(?=\\s|$)(?!.*\\[no tests to run\\])|[ \\t]*--- PASS\\b|(?![ \\t]*--- SKIP: )[^\\r\\n]*\\r?\\nPASS\\r?\\nok[ \\t]+\\S+[ \\t]+(?:\\(cached\\)|\\d[\\d.]*m?s)(?=\\s|$)(?!.*\\[no tests to run\\]))|\\APASS\\r?\\nok[ \\t]+\\S+[ \\t]+(?:\\(cached\\)|\\d[\\d.]*m?s)(?=\\s|$)(?!.*\\[no tests to run\\])", "exits": [0]},
    {"id": "go", "runner": "go test", "pattern": "^(?:\\?|ok)[ \\t]+\\S+[ \\t].*\\[no test(?: files|s to run)\\][ \\t\\r]*$", "positive": "^(?:(?<!PASS\\n)(?<!PASS\\r\\n)ok[ \\t]+\\S+[ \\t]+(?:\\(cached\\)|\\d[\\d.]*m?s)(?=\\s|$)(?!.*\\[no tests to run\\])|[ \\t]*--- PASS\\b|(?![ \\t]*--- SKIP: )[^\\r\\n]*\\r?\\nPASS\\r?\\nok[ \\t]+\\S+[ \\t]+(?:\\(cached\\)|\\d[\\d.]*m?s)(?=\\s|$)(?!.*\\[no tests to run\\]))|\\APASS\\r?\\nok[ \\t]+\\S+[ \\t]+(?:\\(cached\\)|\\d[\\d.]*m?s)(?=\\s|$)(?!.*\\[no tests to run\\])", "exits": [0]},
    {"id": "cargo-all-ignored", "kind": "all_skipped", "runner": "cargo test, every test ignored", "pattern": "^test result: ok\\. 0 passed; 0 failed; [1-9]\\d* ignored;", "positive": "^test result: \\w+\\. (?:[1-9]\\d* passed|0 passed; [1-9]\\d* failed|\\d+ passed; \\d+ failed; \\d+ ignored; [1-9]\\d* measured)\\b", "exits": [0]},
    {"id": "cargo", "runner": "cargo test", "pattern": "^running 0 tests[ \\t\\r]*$", "positive": "^test result: \\w+\\. (?:[1-9]\\d* passed|0 passed; [1-9]\\d* failed|\\d+ passed; \\d+ failed; \\d+ ignored; [1-9]\\d* measured)\\b", "exits": [0]}
  ]
}
